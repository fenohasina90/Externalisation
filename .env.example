# Copier ce fichier vers .env (non versionné) et adapter les valeurs.
# Le backend charge automatiquement le .env à la racine du dépôt (ou dans backend/).
# En production, préférer les variables d'environnement ou un coffre-fort de secrets.
# Générer la clé : openssl rand -base64 64 | tr -d '\n'

JWT_SECRET=remplacer-par-une-cle-base64-de-64-octets
JWT_EXPIRATION_MS=3600000

DB_URL=jdbc:mysql://localhost:3306/gestion_externalisation
DB_USERNAME=root
DB_PASSWORD=

# Production : validate. Développement local uniquement : update.
JPA_DDL_AUTO=validate
CORS_ALLOWED_ORIGINS=http://localhost:5173
